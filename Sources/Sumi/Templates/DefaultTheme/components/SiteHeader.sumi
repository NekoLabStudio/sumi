@component SiteHeader() {
  <div class="site-header-wrap">
    <header class="site-header h-card">
      <a class="site-title u-url p-name" href="/">@if site.avatar {<img class="site-avatar u-photo" src="{site.avatar}" alt="">}<span>{site.title}</span></a>
      <nav class="site-nav" aria-label="Site">
        @if site.navigation.size > 0 {
        @for item in site.navigation {<a href="{item.url}">{item.name}</a>}
        } else {
        @for page in collections.pages {<a href="{page.urlPath}">{page.title}</a>}
        }
        <a class="nav-rss" href="/feed.xml"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/></svg><span>RSS</span></a>
      </nav>
    </header>
  </div>
}
